# Runtime environment. COOKIE_SECURE must be true in staging and production.
APP_ENV=local
COOKIE_SECURE=false

# Required only for online Alembic commands. Keep real credentials in .env.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE

# Authentication. Generate at least 32 random bytes; never commit a real value.
JWT_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Supabase Storage credentials. Keep all values server-only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SERVER_ONLY

# OpenAI credentials are server-only.
OPENAI_API_KEY=REPLACE_ME_SERVER_ONLY

# Non-production Qdrant Cloud and explicit embedding-profile configuration.
# The Qdrant integration test adds a random `_test_` suffix and cleans up only that collection.
QDRANT_URL=https://<cluster>.cloud.qdrant.io
QDRANT_API_KEY=REPLACE_ME_SERVER_ONLY
QDRANT_COLLECTION_PREFIX=agenthub_dev_knowledge
EMBEDDING_MODEL=REPLACE_WITH_VERIFIED_MODEL
EMBEDDING_DIMENSIONS=REPLACE_WITH_VERIFIED_DIMENSIONS
EMBEDDING_PROVIDER_REVISION=
