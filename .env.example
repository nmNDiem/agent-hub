# Runtime environment. COOKIE_SECURE must be true in staging and production.
APP_ENV=local
COOKIE_SECURE=false

# Required only for online Alembic commands. Keep real credentials in .env.
# Prefer the Supabase Direct connection for long-lived API/worker processes when IPv6 is available.
# Use the Session Pooler on port 5432 only when the runtime requires IPv4.
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Authentication. Generate at least 32 random bytes; never commit a real value.
JWT_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Supabase Storage credentials. Keep all values server-only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SERVER_ONLY

# OpenAI credentials are server-only.
OPENAI_API_KEY=REPLACE_ME_SERVER_ONLY

# Explicit verified generation model. The application still fails closed if omitted.
GENERATION_MODEL=gpt-6-luna
# Dedicated image-understanding model. Widget image input stays disabled until verified.
VISION_MODEL=REPLACE_WITH_VERIFIED_OPENAI_VISION_MODEL

# Facebook Messenger. Pin a currently supported Graph API version during deployment review.
FACEBOOK_APP_ID=REPLACE_WITH_META_APP_ID
FACEBOOK_APP_SECRET=REPLACE_ME_SERVER_ONLY
FACEBOOK_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_AT_LEAST_16_RANDOM_BYTES
FACEBOOK_GRAPH_API_VERSION=REPLACE_WITH_VERIFIED_GRAPH_API_VERSION

# Public origin that serves the built widget loader. Loopback is for local development only.
WIDGET_PUBLIC_BASE_URL=http://127.0.0.1:4173
# Separate HMAC key for minimizing abuse identifiers in widget rate-limit records.
WIDGET_ABUSE_HASH_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Non-production Qdrant Cloud and explicit embedding-profile configuration.
# The Qdrant integration test adds a random `_test_` suffix and cleans up only that collection.
QDRANT_URL=https://<cluster>.cloud.qdrant.io
QDRANT_API_KEY=REPLACE_ME_SERVER_ONLY
QDRANT_COLLECTION_PREFIX=agenthub_dev_knowledge
EMBEDDING_MODEL=REPLACE_WITH_VERIFIED_MODEL
EMBEDDING_DIMENSIONS=REPLACE_WITH_VERIFIED_DIMENSIONS
