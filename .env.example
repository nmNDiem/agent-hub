# FastAPI runtime
AGENT_HUB_APP_ENV=local

# Required only for online Alembic commands. Keep real credentials in .env.
AGENT_HUB_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE

# F1 authentication. Generate at least 32 random bytes; never commit a real value.
AGENT_HUB_JWT_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
AGENT_HUB_ACCESS_TOKEN_MINUTES=15
AGENT_HUB_REFRESH_TOKEN_DAYS=14
AGENT_HUB_COOKIE_SECURE=false

# Keep false until a real EmailDelivery provider is configured server-side.
AGENT_HUB_EMAIL_DELIVERY_ENABLED=false

# Reserved server-only settings for later approved phases.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SERVER_ONLY
AGENT_HUB_STORAGE_PRIVATE_BUCKET=agent-hub-private
AGENT_HUB_CATALOG_IMAGE_MAX_BYTES=5242880
AGENT_HUB_CATALOG_IMAGE_MAX_PIXELS=20000000
AGENT_HUB_STORAGE_SIGNED_URL_SECONDS=300
AGENT_HUB_CATALOG_CSV_MAX_BYTES=2097152
AGENT_HUB_CATALOG_CSV_MAX_ROWS=5000
AGENT_HUB_CATALOG_IMPORT_LEASE_SECONDS=300
OPENAI_API_KEY=REPLACE_ME_SERVER_ONLY
