# FastAPI runtime
APP_ENV=local

# Required only for online Alembic commands. Keep real credentials in .env.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE

# Authentication. Generate at least 32 random bytes; never commit a real value.
JWT_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false

# Keep false until a real EmailDelivery provider is configured server-side.
EMAIL_DELIVERY_ENABLED=false

# Supabase Storage and catalog limits. Keep all values server-only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SERVER_ONLY
STORAGE_PRIVATE_BUCKET=agent-hub-private
CATALOG_IMAGE_MAX_BYTES=5242880
CATALOG_IMAGE_MAX_PIXELS=20000000
STORAGE_SIGNED_URL_SECONDS=300
CATALOG_CSV_MAX_BYTES=2097152
CATALOG_CSV_MAX_ROWS=5000
CATALOG_IMPORT_MAX_BYTES=10485760
CATALOG_IMPORT_MAX_ROWS=20000
CATALOG_IMPORT_MAX_COLUMNS=200
CATALOG_IMPORT_MAX_SHEETS=20
CATALOG_IMPORT_LEASE_SECONDS=300
# Optional dedicated PostgreSQL database used by the integration suite.
TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/TEST_DATABASE
OPENAI_API_KEY=REPLACE_ME_SERVER_ONLY

# F3 knowledge retrieval. Qdrant and embedding settings are server-only.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=agenthub_knowledge
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=REPLACE_WITH_VERIFIED_MODEL
EMBEDDING_DIMENSIONS=REPLACE_WITH_VERIFIED_DIMENSIONS
EMBEDDING_PIPELINE_VERSION=v1
